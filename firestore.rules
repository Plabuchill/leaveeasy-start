// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
// สัปดาห์ที่ 7: กฎขั้นต่ำเพียงข้อเดียว — ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนได้
// (กฎรายบทบาทละเอียด เช่น employee เห็นเฉพาะใบตัวเอง เป็นงานสัปดาห์ที่ 8)
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
